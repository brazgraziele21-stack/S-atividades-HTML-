.box {
  width: 200px;
  height: 100px;
  background-color: lightgreen;
  padding: 20px;
  border: 5px solid blue;
  margin: 10px;
}

.box1 {
  width: 200px;
  height: 100px;
  padding: 20px;
  border: 5px solid blue;
  background-color: lightgreen;
  box-sizing: content-box;
  display: inline-block;
}

.box2 {
  width: 200px;
  height: 100px;
  padding: 20px;
  border: 5px solid blue;
  background-color: lightgreen;
  box-sizing: border-box;
  display: inline-block;
}

.caixa1 {
  width: 200px;
  height: 100px;
  background-color: lightgreen;
  border: 5px solid blue;
  border-radius: 15px;
  box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.caixa2 {
  width: 200px;
  height: 100px;
  background-color: lightgreen;
  border: 5px dashed blue;
  border-radius: 15px;
  box-shadow: 10px 10px 20px rgba(0, 0, 0, 0.3);
  margin-top: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.caixa3 {
  width: 200px;
  height: 100px;
  background-color: lightgreen;
  border: 5px double blue;
  border-radius: 15px;
  box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.8);
  margin-top: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.caixa-cor {
  width: 200px;
  height: 100px;
  background-color: darkblue;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
}

.caixa-cover {
  width: 200px;
  height: 100px;
  background-image: url('https://picsum.photos/400/300');
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  margin-top: 20px;
}

.caixa-contain {
  width: 200px;
  height: 100px;
  background-image: url('https://picsum.photos/400/300');
  background-repeat: no-repeat;
  background-size: contain;
  background-position: center;
  background-color: lightgray;
  margin-top: 20px;
}

.card {
  width: 100%;
  height: 200px;
  background:
    linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)),
    url('https://picsum.photos/1600/900') center/cover no-repeat;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
}

h2 {
  color: blue;
}

.titulo {
  color: green;
}

#titulo {
  color: red;
}
