* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Roboto", Arial, sans-serif;
}

body {
    background-color: #0f0f0f;
    color: #f1f1f1;
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 16px;
    height: 56px;
    background-color: #0f0f0f;
    z-index: 10;
}

.nav-left, .nav-right {
    display: flex;
    align-items: center;
    gap: 16px;
}

.menu-btn {
    background: none;
    border: none;
    color: white;
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
}

.logo {
    font-weight: bold;
    font-size: 20px;
    letter-spacing: -1px;
    display: flex;
    align-items: center;
}

.nav-center {
    display: flex;
    flex: 0 1 600px;
}

.nav-center input {
    width: 100%;
    padding: 10px 16px;
    background-color: #121212;
    border: 1px solid #303030;
    border-radius: 40px 0 0 40px;
    color: white;
    font-size: 14px;
}

.nav-center input:focus {
    outline: 1px solid #1c62b9;
}

.search-btn {
    padding: 0 24px;
    background-color: #222222;
    border: 1px solid #303030;
    border-left: none;
    border-radius: 0 40px 40px 0;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
}

.icon {
    font-size: 14px;
    cursor: pointer;
    background-color: #222222;
    padding: 8px 14px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.profile-pic {
    width: 32px;
    height: 32px;
    background-color: #555;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

.profile-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.main-container {
    display: flex;
    flex: 1;
    overflow: hidden;
}

.sidebar {
    width: 240px;
    background-color: #0f0f0f;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    overflow-y: auto;
    flex-shrink: 0;
}

.sidebar::-webkit-scrollbar {
    width: 8px;
}

.sidebar::-webkit-scrollbar-thumb {
    background-color: transparent;
    border-radius: 4px;
}

.sidebar:hover::-webkit-scrollbar-thumb {
    background-color: #3f3f3f;
}

.side-title {
    font-size: 14px;
    font-weight: bold;
    padding: 6px 12px;
    color: #f1f1f1;
    margin-top: 6px;
}

.side-item {
    padding: 10px 12px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: flex;
    align-items: center;
    gap: 24px;
}

.sidebar i, .menu-btn i, .next-category-btn i, .search-btn i, .nav-right i {
    width: 20px;
    text-align: center;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.side-item:hover {
    background-color: #272727;
}

.side-item.active {
    background-color: #272727;
    font-weight: 500;
}

hr {
    border: 0;
    border-top: 1px solid #303030;
    margin: 8px 0;
}

.content-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0 24px;
    overflow-y: auto;
}

.categories-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: #0f0f0f;
    position: relative;
    flex-shrink: 0;
}

.categories {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 8px 0;
    overflow-x: auto;
    flex: 1;
}

.categories::-webkit-scrollbar {
    display: none;
}

.category-chip {
    background-color: #272727;
    color: #f1f1f1;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
}

.category-chip.active {
    background-color: #ffffff;
    color: #0f0f0f;
}

.category-chip:hover:not(.active) {
    background-color: #3f3f3f;
}

.next-category-btn {
    background-color: #0f0f0f;
    border: none;
    color: white;
    font-size: 14px;
    cursor: pointer;
    padding: 0 8px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.video-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 8px;
}

.video-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1 1 calc(33.333% - 16px); 
    min-width: 320px;
    margin-bottom: 40px;
}

.thumbnail {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #272727;
    border-radius: 12px;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    cursor: pointer;
}

.thumbnail:hover .thumb-img {
    transform: scale(1.02);
}

.video-time {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background-color: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 3px 6px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    z-index: 2;
}

.video-info {
    display: flex;
    gap: 12px;
}

.channel-pic {
    width: 36px;
    height: 36px;
    background-color: #444;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

.channel-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.video-text h3 {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    max-height: 40px;
    margin-bottom: 4px;
    color: #f1f1f1;
    overflow: hidden;
}

.channel-name, .video-stats {
    font-size: 12px;
    color: #aaa;
}

.channel-name {
    margin-bottom: 2px;
}

.thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
    transition: transform 0.2s ease;
}
