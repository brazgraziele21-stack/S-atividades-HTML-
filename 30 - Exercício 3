<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Exercício 3 - Areas Nomeadas</title>
<style>
    * {
        margin: 0;
        box-sizing: border-box;
        font-family: sans-serif;
    }

    .pagina {
        display: grid;
        grid-template-areas:
            "cabecalho cabecalho"
            "menu conteudo"
            "rodape rodape";
        grid-template-columns: 200px 1fr;
        grid-template-rows: 80px 1fr 60px;
        height: 100vh;
        gap: 4px;
    }

    .cabecalho {
        grid-area: cabecalho;
        background-color: #2c3e50;
        color: white;
        display: flex;
        align-items: center;
        padding: 0 20px;
    }

    .menu-lateral {
        grid-area: menu;
        background-color: #34495e;
        color: white;
        padding: 20px;
    }

    .conteudo-principal {
        grid-area: conteudo;
        background-color: #ecf0f1;
        padding: 20px;
    }

    .rodape {
        grid-area: rodape;
        background-color: #2c3e50;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>
</head>
<body>

    <div class="pagina">
        <header class="cabecalho">Cabeçalho</header>
        <aside class="menu-lateral">Menu Lateral</aside>
        <main class="conteudo-principal">Conteúdo Principal</main>
        <footer class="rodape">Rodapé</footer>
    </div>

</body>
</html>
