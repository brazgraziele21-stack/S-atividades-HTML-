<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Spotify - Grid</title>
<link
  rel="stylesheet"
  href="https://cdn-uicons.flaticon.com/uicons-regular-rounded/css/uicons-regular-rounded.css"
/>
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, sans-serif;
    }

    body {
        background-color: #121212;
        color: #ffffff;
        display: grid;
        grid-template-rows: 64px 1fr;
        height: 100vh;
        overflow: hidden;
    }

    /* ===== CABEÇALHO ===== */
    .cabecalho {
        display: grid;
        grid-template-columns: 40px 40px 1fr auto auto;
        align-items: center;
        column-gap: 24px;
        padding: 0 24px;
        background-color: #000000;
    }

    .logo-spotify {
        font-size: 22px;
        color: #1ed760;
    }

    .botao-home {
        width: 40px;
        height: 40px;
        background-color: #1a1a1a;
        border-radius: 50%;
        display: grid;
        place-items: center;
        color: white;
        cursor: pointer;
    }

    .barra-busca {
        display: grid;
        grid-template-columns: 24px 1fr 24px;
        align-items: center;
        column-gap: 12px;
        background-color: #1a1a1a;
        border-radius: 24px;
        padding: 10px 16px;
        max-width: 420px;
    }

    .barra-busca input {
        background: none;
        border: none;
        color: white;
        font-size: 14px;
        outline: none;
    }

    .barra-busca i {
        color: #b3b3b3;
        display: grid;
        place-items: center;
    }

    .links-cabecalho {
        display: grid;
        grid-auto-flow: column;
        column-gap: 20px;
        font-size: 14px;
        font-weight: bold;
        color: #b3b3b3;
    }

    .links-cabecalho span {
        cursor: pointer;
    }

    .acoes-cabecalho {
        display: grid;
        grid-auto-flow: column;
        column-gap: 20px;
        align-items: center;
    }

    .botao-inscrever {
        color: #b3b3b3;
        font-weight: bold;
        font-size: 14px;
        cursor: pointer;
    }

    .botao-entrar {
        background-color: white;
        color: black;
        font-weight: bold;
        font-size: 14px;
        padding: 12px 32px;
        border-radius: 24px;
        cursor: pointer;
    }

    /* ===== CONTAINER PRINCIPAL ===== */
    .container-principal {
        display: grid;
        grid-template-columns: 280px 1fr;
        overflow: hidden;
    }

    /* ===== BARRA LATERAL ===== */
    .menu-lateral {
        background-color: #000000;
        padding: 20px;
        display: grid;
        grid-template-rows: auto 1fr auto;
        row-gap: 20px;
        overflow-y: auto;
    }

    .topo-biblioteca {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
    }

    .titulo-biblioteca {
        font-weight: bold;
        font-size: 16px;
        color: #b3b3b3;
    }

    .botao-criar {
        display: grid;
        grid-template-columns: 16px auto;
        column-gap: 6px;
        align-items: center;
        background-color: #1a1a1a;
        color: white;
        font-size: 13px;
        font-weight: bold;
        padding: 8px 12px;
        border-radius: 20px;
        cursor: pointer;
    }

    .cartoes-biblioteca {
        display: grid;
        row-gap: 16px;
        align-content: start;
    }

    .cartao-promo {
        background-color: #1a1a1a;
        border-radius: 10px;
        padding: 16px;
        display: grid;
        row-gap: 12px;
    }

    .cartao-promo h4 {
        font-size: 15px;
    }

    .cartao-promo p {
        font-size: 13px;
        color: #b3b3b3;
    }

    .botao-branco {
        background-color: white;
        color: black;
        font-weight: bold;
        font-size: 13px;
        padding: 10px 16px;
        border-radius: 20px;
        cursor: pointer;
        justify-self: start;
    }

    .rodape-lateral {
        display: grid;
        row-gap: 12px;
        font-size: 12px;
        color: #b3b3b3;
        align-content: end;
    }

    .links-rodape {
        display: grid;
        grid-template-columns: repeat(3, auto);
        column-gap: 16px;
    }

    .seletor-idioma {
        border: 1px solid #b3b3b3;
        border-radius: 20px;
        padding: 8px 12px;
        display: grid;
        grid-template-columns: 16px auto;
        column-gap: 8px;
        align-items: center;
        justify-content: start;
        width: fit-content;
    }

    /* ===== ÁREA DE CONTEÚDO ===== */
    .area-conteudo {
        background-color: #121212;
        padding: 24px 32px;
        overflow-y: auto;
        display: grid;
        row-gap: 32px;
        align-content: start;
    }

    .filtros {
        display: grid;
        grid-auto-flow: column;
        column-gap: 8px;
        justify-content: start;
    }

    .filtro {
        background-color: #232323;
        color: white;
        font-size: 14px;
        font-weight: 500;
        padding: 8px 16px;
        border-radius: 20px;
        cursor: pointer;
    }

    .filtro.ativo {
        background-color: white;
        color: black;
    }

    .secao {
        display: grid;
        row-gap: 16px;
    }

    .cabecalho-secao {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
    }

    .cabecalho-secao h2 {
        font-size: 22px;
    }

    .mostrar-tudo {
        font-size: 13px;
        font-weight: bold;
        color: #b3b3b3;
        cursor: pointer;
    }

    .grade-cartoes {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        column-gap: 20px;
        row-gap: 20px;
    }

    .cartao-musica {
        display: grid;
        row-gap: 12px;
    }

    .cartao-musica img {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 6px;
    }

    .cartao-musica h3 {
        font-size: 15px;
        font-weight: 500;
    }

    .cartao-musica p {
        font-size: 13px;
        color: #b3b3b3;
    }

    .grade-artistas {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        column-gap: 20px;
        row-gap: 20px;
    }

    .cartao-artista {
        display: grid;
        row-gap: 12px;
        justify-items: start;
    }

    .cartao-artista img {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 50%;
    }

    .cartao-artista h3 {
        font-size: 15px;
        font-weight: 500;
    }

    .cartao-artista p {
        font-size: 13px;
        color: #b3b3b3;
    }
</style>
</head>
<body>

    <header class="cabecalho">
        <div class="botao-home"><i class="fi fi-rr-home"></i></div>
        <div></div>
        <div class="barra-busca">
            <i class="fi fi-rs-search"></i>
            <input type="text" placeholder="O que você quer ouvir?">
            <i class="fi fi-rr-basket-shopping-simple"></i>
        </div>
        <div class="links-cabecalho">
            <span>Premium</span>
            <span>Suporte</span>
            <span>Baixar</span>
        </div>
        <div class="acoes-cabecalho">
            <span class="botao-inscrever">Instalar aplicativo</span>
            <span class="botao-inscrever">Inscrever-se</span>
            <span class="botao-entrar">Entrar</span>
        </div>
    </header>

    <div class="container-principal">

        <aside class="menu-lateral">
            <div class="topo-biblioteca">
                <span class="titulo-biblioteca">Sua Biblioteca</span>
                <div class="botao-criar"><i class="fi fi-rr-plus"></i> Criar</div>
            </div>

            <div class="cartoes-biblioteca">
                <div class="cartao-promo">
                    <h4>Crie sua primeira playlist</h4>
                    <p>É fácil, vamos te ajudar.</p>
                    <span class="botao-branco">Criar playlist</span>
                </div>
                <div class="cartao-promo">
                    <h4>Que tal seguir um podcast novo?</h4>
                    <p>Avisaremos você sobre novos episódios.</p>
                    <span class="botao-branco">Explorar podcasts</span>
                </div>
            </div>

            <div class="rodape-lateral">
                <div class="links-rodape">
                    <span>Legal</span>
                    <span>Segurança e Centro de privacidade</span>
                    <span>Privacidade</span>
                </div>
                <div class="links-rodape">
                    <span>Cookies</span>
                    <span>Sobre anúncios</span>
                    <span>Acessibilidade</span>
                </div>
                <div class="seletor-idioma">
                    <i class="fi fi-rr-globe"></i>
                    <span>Português do Brasil</span>
                </div>
            </div>
        </aside>

        <main class="area-conteudo">

            <nav class="filtros">
                <span class="filtro ativo">Tudo</span>
                <span class="filtro">Música</span>
                <span class="filtro">Podcasts</span>
            </nav>

            <section class="secao">
                <div class="cabecalho-secao">
                    <h2>Músicas em alta</h2>
                    <span class="mostrar-tudo">Mostrar tudo</span>
                </div>
                <div class="grade-cartoes">
                    <div class="cartao-musica">
                        <img src="https://picsum.photos/id/1025/300/300" alt="Capa 1">
                        <h3>Pau Pra Toda Obra</h3>
                        <p>Mc Jacaré, MC Ryan SP, Mc Lele JP</p>
                    </div>
                    <div class="cartao-musica">
                        <img src="https://picsum.photos/id/1035/300/300" alt="Capa 2">
                        <h3>Bala Alojada</h3>
                        <p>Gusttavo Lima</p>
                    </div>
                    <div class="cartao-musica">
                        <img src="https://picsum.photos/id/1045/300/300" alt="Capa 3">
                        <h3>Cuida do Pet</h3>
                        <p>Oldilla, Mc Iguinho Ct</p>
                    </div>
                    <div class="cartao-musica">
                        <img src="https://picsum.photos/id/1055/300/300" alt="Capa 4">
                        <h3>Vale a Pena Ouvir de Novo</h3>
                        <p>Zé Vitor & Rael</p>
                    </div>
                    <div class="cartao-musica">
                        <img src="https://picsum.photos/id/1062/300/300" alt="Capa 5">
                        <h3>Pacman de Panicat</h3>
                        <p>DJ Japa NK, Mc Poze do Rodo</p>
                    </div>
                    <div class="cartao-musica">
                        <img src="https://picsum.photos/id/1074/300/300" alt="Capa 6">
                        <h3>Só Com Ela - Ao Vivo</h3>
                        <p>Murilo Huff, Matheus Fernandes</p>
                    </div>
                </div>
            </section>

            <section class="secao">
                <div class="cabecalho-secao">
                    <h2>Artistas populares</h2>
                    <span class="mostrar-tudo">Mostrar tudo</span>
                </div>
                <div class="grade-artistas">
                    <div class="cartao-artista">
                        <img src="https://picsum.photos/id/1005/300/300" alt="Artista 1">
                        <h3>Henrique & Juliano</h3>
                        <p>Artista</p>
                    </div>
                    <div class="cartao-artista">
                        <img src="https://picsum.photos/id/1012/300/300" alt="Artista 2">
                        <h3>Diego & Victor Hugo</h3>
                        <p>Artista</p>
                    </div>
                    <div class="cartao-artista">
                        <img src="https://picsum.photos/id/1027/300/300" alt="Artista 3">
                        <h3>Grupo Menos É Mais</h3>
                        <p>Artista</p>
                    </div>
                    <div class="cartao-artista">
                        <img src="https://picsum.photos/id/1011/300/300" alt="Artista 4">
                        <h3>Jorge & Mateus</h3>
                        <p>Artista</p>
                    </div>
                    <div class="cartao-artista">
                        <img src="https://picsum.photos/id/1013/300/300" alt="Artista 5">
                        <h3>Zé Neto & Cristiano</h3>
                        <p>Artista</p>
                    </div>
                </div>
            </section>

            <section class="secao">
                <div class="cabecalho-secao">
                    <h2>Singles e álbuns que todo mundo gosta</h2>
                    <span class="mostrar-tudo">Mostrar tudo</span>
                </div>
                <div class="grade-cartoes">
                    <div class="cartao-musica">
                        <img src="https://picsum.photos/id/1084/300/300" alt="Álbum 1">
                        <h3>Álbum 1</h3>
                        <p>Artista</p>
                    </div>
                    <div class="cartao-musica">
                        <img src="https://picsum.photos/id/1080/300/300" alt="Álbum 2">
                        <h3>Álbum 2</h3>
                        <p>Artista</p>
                    </div>
                    <div class="cartao-musica">
                        <img src="https://picsum.photos/id/1069/300/300" alt="Álbum 3">
                        <h3>Álbum 3</h3>
                        <p>Artista</p>
                    </div>
                    <div class="cartao-musica">
                        <img src="https://picsum.photos/id/1082/300/300" alt="Álbum 4">
                        <h3>Álbum 4</h3>
                        <p>Artista</p>
                    </div>
                </div>
            </section>

        </main>
    </div>

</body>
</html>
