<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>YouTube - Flexbox</title>

    <link
      rel="stylesheet"
      href="https://cdn-uicons.flaticon.com/uicons-regular-rounded/css/uicons-regular-rounded.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn-uicons.flaticon.com/4.0.0/uicons-regular-rounded/css/uicons-regular-rounded.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn-uicons.flaticon.com/4.0.0/uicons-solid-rounded/css/uicons-solid-rounded.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn-uicons.flaticon.com/4.0.0/uicons-regular-straight/css/uicons-regular-straight.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn-uicons.flaticon.com/4.0.0/uicons-bold-rounded/css/uicons-bold-rounded.css"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        border: 0;
        box-sizing: border-box;
        font-family: "Roboto", Arial, sans-serif;
      }

      body {
        background-color: #0f0f0f;
        color: #f1f1f1;
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
      }

      .barra-superior {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 16px;
        height: 56px;
        background-color: #0f0f0f;
        border-bottom: 1px solid #303030;
      }

      .nav-esquerda,
      .nav-direita {
        display: flex;
        align-items: center;
        gap: 20px;
      }

      .botao-menu {
        background: none;
        border: none;
        color: white;
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
      }

      .logotipo {
        font-weight: bold;
        font-size: 20px;
        letter-spacing: -1px;
        display: flex;
        align-items: center;
      }

      .logo-youtube {
        width: 28px;
        height: auto;
        margin-right: 6px;
      }

      .nav-central {
        display: flex;
        flex: 0 1 600px;
      }

      .nav-central input {
        width: 100%;
        padding: 10px 16px;
        background-color: #121212;
        border: 1px solid #303030;
        border-radius: 40px 0 0 40px;
        color: white;
        font-size: 14px;
      }

      .nav-central input:focus {
        outline: 1px solid #1c62b9;
      }

      .botao-busca {
        padding: 0 24px;
        background-color: #222222;
        border: 1px solid #303030;
        border-left: none;
        border-radius: 0 40px 40px 0;
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .icone {
        font-size: 14px;
        cursor: pointer;
        background-color: #222222;
        padding: 8px 14px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .botao-login {
        display: flex;
        align-items: center;
        gap: 8px;
        background-color: transparent;
        border: 1px solid #303030;
        color: #3ea6ff;
        padding: 8px 16px 8px 12px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
      }

      .botao-login:hover {
        background-color: rgba(62, 166, 255, 0.1);
      }

      .container-principal {
        display: flex;
        flex: 1;
        overflow: hidden;
      }

      .menu-lateral {
        width: 240px;
        background-color: #0f0f0f;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        overflow-y: auto;
        flex-shrink: 0;
      }

      .titulo-secao {
        font-size: 14px;
        font-weight: bold;
        padding: 6px 12px;
        color: #f1f1f1;
        margin-top: 6px;
      }

      .item-menu {
        padding: 10px 12px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 14px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: flex;
        align-items: center;
        gap: 24px;
      }

      .logo-yt-music {
        width: 24px;
        height: 24px;
        margin-right: 16px;
        object-fit: contain;
      }

      .logo-yt-kids {
        width: 24px;
        height: 24px;
        margin-right: 16px;
        object-fit: contain;
      }

      .logo-yt-premium {
        width: 24px;
        height: 24px;
        margin-right: 16px;
        object-fit: contain;
      }

      .menu-lateral i,
      .botao-menu i,
      .botao-proxima-tag i,
      .botao-busca i,
      .nav-direita i {
        width: 20px;
        text-align: center;
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .item-menu:hover {
        background-color: #272727;
      }

      .item-menu.ativo {
        background-color: #272727;
        font-weight: 500;
      }

      hr {
        border: 0;
        border-top: 1px solid #303030;
        margin: 8px 0;
      }

      .area-conteudo {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 0 24px;
        overflow-y: auto;
      }

      .barra-tags {
        display: flex;
        align-items: center;
        gap: 8px;
        background-color: #0f0f0f;
        position: relative;
        flex-shrink: 0;
      }

      .tags {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 56px;
        padding: 8px 0;
        overflow-x: auto;
        flex: 1;
      }

      .tags::-webkit-scrollbar {
        display: none;
      }

      .tag {
        background-color: #272727;
        color: #f1f1f1;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
      }

      .tag.ativo {
        background-color: #ffffff;
        color: #0f0f0f;
      }

      .tag:hover:not(.ativo) {
        background-color: #3f3f3f;
      }

      .botao-proxima-tag {
        background-color: #0f0f0f;
        border: none;
        color: white;
        font-size: 14px;
        cursor: pointer;
        padding: 0 8px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .grade-videos {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        padding-top: 8px;
      }

      .cartao-video {
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex: 1 1 calc(33.333% - 16px);
        min-width: 320px;
        margin-bottom: 40px;
      }

      .miniatura {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        aspect-ratio: 16 / 9;
        background-color: #272727;
        border-radius: 12px;
        position: relative;
        overflow: hidden;
        text-decoration: none;
        cursor: pointer;
      }

      .miniatura:hover .imagem-miniatura {
        transform: scale(1.02);
      }

      .duracao-video {
        position: absolute;
        bottom: 8px;
        right: 8px;
        background-color: rgba(0, 0, 0, 0.8);
        color: white;
        padding: 3px 6px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 500;
        z-index: 2;
      }

      .info-video {
        display: flex;
        gap: 12px;
      }

      .foto-canal {
        width: 36px;
        height: 36px;
        background-color: #444;
        border-radius: 50%;
        flex-shrink: 0;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .foto-canal img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .texto-video h3 {
        font-size: 14px;
        font-weight: 500;
        line-height: 20px;
        max-height: 40px;
        margin-bottom: 4px;
        color: #f1f1f1;
        overflow: hidden;
      }

      .nome-canal,
      .estatisticas-video {
        font-size: 12px;
        color: #aaa;
      }

      .nome-canal {
        margin-bottom: 2px;
      }

      .imagem-miniatura {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 12px;
        transition: transform 0.2s ease;
      }
    </style>
  </head>
  <body>
    <header class="barra-superior">
      <div class="nav-esquerda">
        <button class="botao-menu"><i class="fi fi-rr-menu-burger"></i></button>
        <div class="logotipo">
          <img src="youtube.png" alt="Logo YouTube" class="logo-youtube" />
          YouTube
        </div>
      </div>
      <div class="nav-central">
        <input type="text" placeholder="Procurar" />
        <button class="botao-busca"><i class="fi fi-rs-search"></i></button>
      </div>
      <div class="nav-direita">
        <span class="icone"><i class="fi fi-br-plus"></i>Criar</span>
        <span class="icone"><i class="fi fi-rr-bell"></i></span>
        <button class="botao-login">
          <i class="fi fi-rr-user"></i>Fazer login
        </button>
      </div>
    </header>

    <div class="container-principal">
      <aside class="menu-lateral">
        <div class="item-menu ativo"><i class="fi fi-rr-home"></i>Lar</div>
        <div class="item-menu"><i class="fi fi-rr-rocket-lunch"></i>Shorts</div>
        <div class="item-menu">
          <i class="fi fi-rr-add-folder"></i>Assinaturas
        </div>
        <hr />
        <div class="titulo-secao">Você</div>
        <div class="item-menu"><i class="fi fi-rr-time-past"></i>Histórico</div>
        <div class="item-menu">
          <i class="fi fi-rr-list-check"></i>Listas de reprodução
        </div>
        <div class="item-menu">
          <i class="fi fi-rr-clock-five"></i>Assistir mais tarde
        </div>
        <div class="item-menu">
          <i class="fi fi-rr-social-network"></i>Vídeos curtidos
        </div>
        <div class="item-menu"><i class="fi fi-rr-download"></i>Downloads</div>
        <hr />
        <div class="titulo-secao">Mais do YouTube</div>
        <div class="item-menu">
          <img
            src="video.png"
            alt="Logo YouTube Premium"
            class="logo-yt-premium"
          />
          YouTube Premium
        </div>
        <div class="item-menu">
          <img src="music.png" alt="Logo YouTube Music" class="logo-yt-music" />
          Música do YouTube
        </div>
        <div class="item-menu">
          <img
            src="youtubeAnimado.png"
            alt="Logo YouTube Kids"
            class="logo-yt-kids"
          />
          YouTube Kids
        </div>
        <hr />
        <div class="titulo-secao">Explorar</div>
        <div class="item-menu"><i class="fi fi-rs-music-alt"></i>Música</div>
        <div class="item-menu"><i class="fi fi-rr-box-alt"></i>Filmes</div>
        <div class="item-menu"><i class="fi fi-sr-interactive"></i>Ao vivo</div>
        <div class="item-menu">
          <i class="fi fi-rr-angle-small-down"></i>Mostrar mais
        </div>

        <hr />
        <div class="item-menu">
          <i class="fi fi-rr-flag-alt"></i>Histórico de relatóri...
        </div>
      </aside>

      <main class="area-conteudo">
        <div class="barra-tags">
          <nav class="tags">
            <span class="tag ativo">Todos</span>
            <span class="tag">Podcasts</span>
            <span class="tag">Psicologia Clínica</span>
            <span class="tag">Consciência</span>
            <span class="tag">Estoicismo</span>
            <span class="tag">Música</span>
            <span class="tag">Jogos</span>
            <span class="tag">Ciências Sociais</span>
            <span class="tag">Autoconfiança</span>
            <span class="tag">Semanas</span>
            <span class="tag">Inteligência</span>
            <span class="tag">Ao vivo</span>
            <span class="tag">Metas</span>
            <span class="tag">Fortuna</span>
            <span class="tag">Música ambiente</span>
          </nav>
          <button class="botao-proxima-tag">
            <i class="fi fi-rr-angle-right"></i>
          </button>
        </div>

        <section class="grade-videos">
          <!-- Vídeo 1 -->
          <div class="cartao-video">
            <a
              href="https://youtu.be/Qjk-cSW-jk4?si=tXcxs5rfYPVWwn5R"
              target="_blank"
              class="miniatura"
            >
              <img
                class="imagem-miniatura"
                src="capafabioakita.png"
                alt="Capa Fábio Akita"
              />
              <span class="duracao-video">47:16</span>
            </a>
            <div class="info-video">
              <div class="foto-canal">
                <img src="fabioakita.png" alt="Fábio Akita" />
              </div>
              <div class="texto-video">
                <h3>
                  Entendendo o Back-End para Programadores Iniciantes (Parte 2)
                  | Série "Começando aos 40"
                </h3>
                <p class="nome-canal">Fábio Akita</p>
                <p class="estatisticas-video">
                  519 mil visualizações • há 2 anos
                </p>
              </div>
            </div>
          </div>
          <!-- Vídeo 2 -->
          <div class="cartao-video">
            <a
              href="https://youtu.be/HE3X5uRd8qM?si=fdKi0ulT368omBuz"
              target="_blank"
              class="miniatura"
            >
              <img
                class="imagem-miniatura"
                src="capaeslendelanogare.png"
                alt="Capa Eslen Delanogare"
              />
              <span class="duracao-video">11:46</span>
            </a>
            <div class="info-video">
              <div class="foto-canal">
                <img src="eslendelanogare.png" alt="Eslen Delanogare" />
              </div>
              <div class="texto-video">
                <h3>Como evitar emburrecer na era dos smartphones</h3>
                <p class="nome-canal">Eslen Delanogare</p>
                <p class="estatisticas-video">
                  132 mil visualizações • há 8 dias
                </p>
              </div>
            </div>
          </div>
          <!-- Vídeo 3 -->
          <div class="cartao-video">
            <a
              href="https://youtu.be/0CpNy1Ph7e8?si=0zpafj7ON0lJABTL"
              target="_blank"
              class="miniatura"
            >
              <img
                class="imagem-miniatura"
                src="capaluanacarolina.png"
                alt="Capa Luana Carolina"
              />
              <span class="duracao-video">15:24</span>
            </a>
            <div class="info-video">
              <div class="foto-canal">
                <img src="luanacarolina.png" alt="Luana Carolina" />
              </div>
              <div class="texto-video">
                <h3>O segredo das pessoas altamente confiantes e produtivas</h3>
                <p class="nome-canal">Luana Carolina</p>
                <p class="estatisticas-video">
                  563 mil visualizações • há 3 meses
                </p>
              </div>
            </div>
          </div>
          <!-- Vídeo 4 -->
          <div class="cartao-video">
            <a
              href="https://www.youtube.com/live/rpTPXqOiGB4?si=o2Cy2pKkDZqqNbNF"
              target="_blank"
              class="miniatura"
            >
              <img
                class="imagem-miniatura"
                src="capabrunoperini.png"
                alt="Capa Bruno Perini"
              />
              <span class="duracao-video">22:15</span>
            </a>
            <div class="info-video">
              <div class="foto-canal">
                <img src="brunoperini.png" alt="Bruno Perini" />
              </div>
              <div class="texto-video">
                <h3>
                  Como montar um plano realista para viver de renda nos próximos
                  anos
                </h3>
                <p class="nome-canal">Bruno Perini - Você MAIS Rico</p>
                <p class="estatisticas-video">
                  489 mil visualizações • há 1 mês
                </p>
              </div>
            </div>
          </div>
          <!-- Vídeo 5 -->
          <div class="cartao-video">
            <a
              href="https://youtu.be/jx9cB0o0lok?si=GANX8qY88-ArsuhL"
              target="_blank"
              class="miniatura"
            >
              <img
                class="imagem-miniatura"
                src="capajoeljota.png"
                alt="Capa Joel Jota"
              />
              <span class="duracao-video">1:12:40</span>
            </a>
            <div class="info-video">
              <div class="foto-canal">
                <img src="joeljota.png" alt="Joel Jota" />
              </div>
              <div class="texto-video">
                <h3>
                  SEJA DISCIPLINADO NA VIDA (JOEL JOTA) | MOTIVAÇÃO PARA VIDA
                </h3>
                <p class="nome-canal">Joel Jota</p>
                <p class="estatisticas-video">
                  2,1 mi de visualizações • há 5 meses
                </p>
              </div>
            </div>
          </div>
          <!-- Vídeo 6 -->
          <div class="cartao-video">
            <a
              href="https://youtu.be/j1ATvGZ7CK8?si=JoWpBwbGbjQpC8uW"
              target="_blank"
              class="miniatura"
            >
              <img
                class="imagem-miniatura"
                src="capathiagonigro.png"
                alt="Capa Thiago Nigro"
              />
              <span class="duracao-video">23:37</span>
            </a>
            <div class="info-video">
              <div class="foto-canal">
                <img src="thiagonigro.png" alt="Thiago Nigro" />
              </div>
              <div class="texto-video">
                <h3>O Homem Mais Rico Da História Do Brasil (LUIZ BARSI)</h3>
                <p class="nome-canal">O Primo Rico</p>
                <p class="estatisticas-video">
                  1,4 mi de visualizações • há 4 meses
                </p>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
