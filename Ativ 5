<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Ordem Visual</title>
<style>
  .container {
    display: flex;
  }

  .item-a { order: 2; }
  .item-b { order: 3; }
  .item-c { order: 1; }
  .item-d { order: 4; }
</style>
</head>
<body>

  <div class="container">
    <div class="item-a">A</div>
    <div class="item-b">B</div>
    <div class="item-c">C</div>
    <div class="item-d">D</div>
  </div>

</body>
</html>
