<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Card de Produto</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        border: 0;
        box-sizing: border-box;
      }

      body {
        width: 100vw;
        height: 100vh;
        background-color: #ffffff;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .card-wrapper {
        background-color: #f7c343;
        padding: 24px;
        width: 380px;
      }

      .produto-card {
        background-color: #ffffff;
        display: flex;
        flex-direction: column;
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
      }

      .card-header {
        background-color: #faf2e6;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 280px;
      }

      .caixa-sapato {
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .produto-image {
        width: 100%;
        height: 100%;
      }

      .card-body {
        padding: 35px 25px;
        text-align: center;
      }

      .titulo-produto {
        color: #4a1503;
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 12px;
      }

      .descricao-produto {
        color: #7a6a65;
        font-size: 12px;
        line-height: 1.6;
        margin-bottom: 25px;
      }

      .seletor-cores {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 40px;
      }

      .cores {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        cursor: pointer;
      }

      .cor-1 {
        background-color: #f38b72;
      }

      .cor-2 {
        background-color: #55b9b9;
      }

      .cor-3 {
        background-color: #f1b86b;
      }

      .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        padding-bottom: 10px;
      }

      .preco-produto {
        font-size: 28px;
        font-weight: 700;
        color: #4a1503;
        position: relative;
        z-index: 2;
      }

      .botao-add {
        background-color: transparent;
        border: 2px solid #4a1503;
        color: #4a1503;
        padding: 10px 24px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        position: relative;
        z-index: 2;
      }
    </style>
  </head>
  <body>
    <div class="card-wrapper">
      <div class="produto-card">
        <div class="card-header">
          <div class="caixa-sapato">
            <img src="sapato.png" alt="Sapato" class="produto-image" />
          </div>
        </div>

        <div class="card-body">
          <h1 class="titulo-produto">Lorem Ipsum</h1>
          <p class="descricao-produto">
            Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam
            nonummy nibh euismod tincidunt ut.
          </p>

          <div class="seletor-cores">
            <div class="cores cor-1"></div>
            <div class="cores cor-2"></div>
            <div class="cores cor-3"></div>
          </div>

          <div class="card-footer">
            <div class="preco-produto">$45,00</div>
            <button class="botao-add">Add to cart</button>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
