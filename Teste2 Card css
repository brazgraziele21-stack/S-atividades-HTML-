*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:#f6c94c;
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:100vh;
}

.card{
    width:300px;
    background:#fff;
    border-radius:18px;
    overflow:hidden;
    box-shadow:0 12px 25px rgba(0,0,0,.25);
}

.card-top{
    background:#fdf3e4;
    padding:20px;
    text-align:center;
}

.logo{
    text-align:right;
    font-weight:600;
    color:#444;
    margin-bottom:15px;
}

.produto{
    width:210px;
}

.card-bottom{
    padding:25px;
}

.card-bottom h2{
    color:#5b2306;
    margin-bottom:12px;
}

.card-bottom p{
    color:#666;
    font-size:14px;
    line-height:1.6;
    margin-bottom:25px;
}

.footer{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.preco{
    font-size:28px;
    font-weight:bold;
    color:#5b2306;
}

button{
    padding:10px 18px;
    background:white;
    border:2px solid #5b2306;
    border-radius:8px;
    color:#5b2306;
    font-weight:600;
    cursor:pointer;
    box-shadow:0 3px 8px rgba(0,0,0,.15);
}

button:hover{
    background:#5b2306;
    color:white;
}
