<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Exercício 4 - Galeria Responsiva</title>
<style>
    * {
        margin: 0;
        box-sizing: border-box;
        font-family: sans-serif;
    }

    body {
        padding: 20px;
    }

    .galeria {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 12px;
    }

    .galeria img {
        width: 100%;
        height: 150px;
        object-fit: cover;
        border-radius: 8px;
        display: block;
    }
</style>
</head>
<body>

    <h2>Galeria Responsiva</h2>
    <div class="galeria">
        <img src="https://picsum.photos/id/1015/300/200" alt="Foto 1">
        <img src="https://picsum.photos/id/1016/300/200" alt="Foto 2">
        <img src="https://picsum.photos/id/1018/300/200" alt="Foto 3">
        <img src="https://picsum.photos/id/1019/300/200" alt="Foto 4">
        <img src="https://picsum.photos/id/1020/300/200" alt="Foto 5">
        <img src="https://picsum.photos/id/1021/300/200" alt="Foto 6">
    </div>

</body>
</html>
