* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background-color: #000000;
}

.tela {
  position: relative;
  width: 100vw;
  height: 100vh;
}

.dvd {
  --largura: 140px;
  --altura: 70px;

  position: absolute;
  top: 0;
  left: 0;
  width: var(--largura);
  height: var(--altura);

  display: flex;
  align-items: center;
  justify-content: center;

  font-family: Arial, sans-serif;
  font-weight: bold;
  font-size: 22px;
  color: #ffffff;

  border-radius: 8px;
  background-color: #ff3b3b;
  box-shadow: 0 0 25px 8px rgba(255, 59, 59, 0.7);

  animation: mover 12s linear infinite, mudar-cor 12s linear infinite;
}

@keyframes mover {
  0%     { transform: translate(0, 0); }
  16.67% { transform: translate(calc((100vw - var(--largura)) * 0.6667), calc(100vh - var(--altura))); }
  25%    { transform: translate(calc(100vw - var(--largura)), calc((100vh - var(--altura)) * 0.5)); }
  33.33% { transform: translate(calc((100vw - var(--largura)) * 0.6667), 0); }
  50%    { transform: translate(0, calc(100vh - var(--altura))); }
  66.67% { transform: translate(calc((100vw - var(--largura)) * 0.6667), 0); }
  75%    { transform: translate(calc(100vw - var(--largura)), calc((100vh - var(--altura)) * 0.5)); }
  83.33% { transform: translate(calc((100vw - var(--largura)) * 0.6667), calc(100vh - var(--altura))); }
  100%   { transform: translate(0, 0); }
}

@keyframes mudar-cor {
  0%      { background-color: #ff3b3b; box-shadow: 0 0 25px 8px rgba(255, 59, 59, 0.7); }
  16.67%  { background-color: #3bff6e; box-shadow: 0 0 25px 8px rgba(59, 255, 110, 0.7); }
  33.33%  { background-color: #3b9fff; box-shadow: 0 0 25px 8px rgba(59, 159, 255, 0.7); }
  50%     { background-color: #fff23b; box-shadow: 0 0 25px 8px rgba(255, 242, 59, 0.7); }
  66.67%  { background-color: #ff3bd9; box-shadow: 0 0 25px 8px rgba(255, 59, 217, 0.7); }
  83.33%  { background-color: #3bfff2; box-shadow: 0 0 25px 8px rgba(59, 255, 242, 0.7); }
  100%    { background-color: #ff3b3b; box-shadow: 0 0 25px 8px rgba(255, 59, 59, 0.7); }
}
