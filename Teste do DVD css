* {
  margin: 0;
  padding: 0;
  border: 0;
  box-sizing: border-box;
}

body {
  width: 100vw;
  height: 100vh;
  background-color: black;
  justify-content: center;
  align-items: center;
  display: flex;
  overflow: hidden;
}

.card {
  width: 250px;
  height: 90px;
  border-radius: 60%;
  background-color: darkmagenta;
  box-shadow: 0 0 25px 5px rgba(139, 0, 139, 0.7); 
  
  display: flex;
  justify-content: center;
  align-items: center;
  
  font-family: Arial, sans-serif;
  font-weight: bold;
  font-size: 24px;
  color: white;

  animation: fadeUp 10s linear infinite;
}

@keyframes fadeUp {
  0% {
    transform: translate(0, 0);
    background-color: darkmagenta;
    box-shadow: 0 0 25px 5px rgba(139, 0, 139, 0.7);
  }
  10% {
    transform: translate(calc(50vw - 125px), 0);
    background-color: darkmagenta;
    box-shadow: 0 0 25px 5px rgba(139, 0, 139, 0.7);
  }
  11% {
    transform: translate(calc(50vw - 125px), 0);
    background-color: darkred;
    box-shadow: 0 0 25px 5px rgba(139, 0, 0, 0.7);
  }
  20% {
    transform: translate(0, calc(50vh - 45px));
    background-color: darkred;
    box-shadow: 0 0 25px 5px rgba(139, 0, 0, 0.7);
  }
  21% {
    transform: translate(0, calc(50vh - 45px));
    background-color: darkgoldenrod;
    box-shadow: 0 0 25px 5px rgba(184, 134, 11, 0.7);
  }
  30% {
    transform: translate(calc(-50vw + 125px), 0);
    background-color: darkgoldenrod;
    box-shadow: 0 0 25px 5px rgba(184, 134, 11, 0.7);
  }
  31% {
    transform: translate(calc(-50vw + 125px), 0);
    background-color: darkgreen;
    box-shadow: 0 0 25px 5px rgba(0, 100, 0, 0.7);
  }
  40% {
    transform: translate(0, calc(-50vh + 45px));
    background-color: darkgreen;
    box-shadow: 0 0 25px 5px rgba(0, 100, 0, 0.7);
  }
  41% {
    transform: translate(0, calc(-50vh + 45px));
    background-color: darkblue;
    box-shadow: 0 0 25px 5px rgba(0, 0, 139, 0.7);
  }
  50% {
    transform: translate(calc(50vw - 125px), calc(50vh - 45px));
    background-color: darkblue;
    box-shadow: 0 0 25px 5px rgba(0, 0, 139, 0.7);
  }
  51% {
    transform: translate(calc(50vw - 125px), calc(50vh - 45px));
    background-color: darkcyan;
    box-shadow: 0 0 25px 5px rgba(0, 139, 139, 0.7);
  }
  60% {
    transform: translate(calc(-50vw + 125px), calc(-50vh + 45px));
    background-color: darkcyan;
    box-shadow: 0 0 25px 5px rgba(0, 139, 139, 0.7);
  }
  61% {
    transform: translate(calc(-50vw + 125px), calc(-50vh + 45px));
    background-color: darkorange;
    box-shadow: 0 0 25px 5px rgba(255, 140, 0, 0.7);
  }
  70% {
    transform: translate(calc(-50vw + 125px), calc(50vh - 45px));
    background-color: darkorange;
    box-shadow: 0 0 25px 5px rgba(255, 140, 0, 0.7);
  }
  71% {
    transform: translate(calc(-50vw + 125px), calc(50vh - 45px));
    background-color: darkviolet;
    box-shadow: 0 0 25px 5px rgba(148, 0, 211, 0.7);
  }
  80% {
    transform: translate(calc(50vw - 125px), calc(-50vh + 45px));
    background-color: darkviolet;
    box-shadow: 0 0 25px 5px rgba(148, 0, 211, 0.7);
  }
  81% {
    transform: translate(calc(50vw - 125px), calc(-50vh + 45px));
    background-color: darkolivegreen;
    box-shadow: 0 0 25px 5px rgba(85, 107, 47, 0.7);
  }
  90% {
    transform: translate(calc(-50vw + 125px), calc(25vh));
    background-color: darkolivegreen;
    box-shadow: 0 0 25px 5px rgba(85, 107, 47, 0.7);
  }
  91% {
    transform: translate(calc(-50vw + 125px), calc(25vh));
    background-color: darkmagenta;
    box-shadow: 0 0 25px 5px rgba(139, 0, 139, 0.7);
  }
  100% {
    transform: translate(0, 0);
    background-color: darkmagenta;
    box-shadow: 0 0 25px 5px rgba(139, 0, 139, 0.7);
  }
}
