* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    background-color: #ffffff;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}

.card-wrapper {
    background-color: #f7c343;
    padding: 24px;
    width: 380px;
}

.product-card {
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
}

.card-header {
    background-color: #fdf3e2;
    padding: 25px;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 280px;
}

.brand-logo {
    align-self: flex-end;
    font-size: 14px;
    font-weight: 600;
    color: #333;
}

.shoe-container {
    margin-top: 15px;
    width: 180px;
    height: 140px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.shoe-illustration {
    width: 150px;
    height: 110px;
    background-color: #e84c3d;
    clip-path: polygon(100% 70%, 85% 100%, 35% 100%, 25% 60%, 15% 15%, 25% 15%, 33% 55%, 65% 55%);
    transform: rotate(-10deg);
    position: relative;
}

.shoe-illustration::after {
    content: '';
    position: absolute;
    left: 22px;
    bottom: 0;
    width: 10px;
    height: 80px;
    background-color: #e84c3d;
    transform: rotate(10deg);
}

.pagination-dots {
    display: flex;
    gap: 6px;
    margin-top: auto;
}

.dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #d1c7bd;
}

.dot.active {
    background-color: #8c7e74;
}

.card-body {
    padding: 35px 25px;
    text-align: center;
}

.product-title {
    color: #4a1503;
    font-size: 26px;
    font-weight: 700;
    margin-bottom: 12px;
}

.product-description {
    color: #7a6a65;
    font-size: 12px;
    line-height: 1.6;
    margin-bottom: 25px;
}

.color-selector {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 40px;
}

.color-circle {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    cursor: pointer;
}

.color-1 { background-color: #f38b72; }
.color-2 { background-color: #55b9b9; }
.color-3 { background-color: #f1b86b; }

.card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    padding-bottom: 10px;
}

.card-footer::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 100%;
    height: 8px;
    background: rgba(0, 0, 0, 0.35);
    filter: blur(5px);
    border-radius: 50%;
    z-index: 1;
}

.product-price {
    font-size: 28px;
    font-weight: 700;
    color: #4a1503;
    position: relative;
    z-index: 2;
}

.btn-add-cart {
    background-color: transparent;
    border: 2px solid #4a1503;
    color: #4a1503;
    padding: 10px 24px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    position: relative;
    z-index: 2;
}
