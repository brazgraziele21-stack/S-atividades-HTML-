<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Exercício 1 - Grid Básico</title>
<style>
    .grade-fixa {
        display: grid;
        grid-template-columns: 100px 100px 100px;
        grid-template-rows: 100px 100px 100px;
        gap: 4px;
        margin-bottom: 40px;
    }

    .grade-flexivel {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(3, 100px);
        gap: 4px;
    }

    .celula {
        background-color: #4a90d9;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: sans-serif;
    }
</style>
</head>
<body>

    <h2 style="font-family: sans-serif;">Versão com valores fixos (100px)</h2>
    <div class="grade-fixa">
        <div class="celula">1</div>
        <div class="celula">2</div>
        <div class="celula">3</div>
        <div class="celula">4</div>
        <div class="celula">5</div>
        <div class="celula">6</div>
        <div class="celula">7</div>
        <div class="celula">8</div>
        <div class="celula">9</div>
    </div>

    <h2 style="font-family: sans-serif;">Versão com repeat() e fr (flexível)</h2>
    <div class="grade-flexivel">
        <div class="celula">1</div>
        <div class="celula">2</div>
        <div class="celula">3</div>
        <div class="celula">4</div>
        <div class="celula">5</div>
        <div class="celula">6</div>
        <div class="celula">7</div>
        <div class="celula">8</div>
        <div class="celula">9</div>
    </div>

</body>
</html>
